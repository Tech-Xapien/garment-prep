# Virtual environment
.venv/

# Stray top-level weights dir. Anchored with a leading slash on purpose: an unanchored
# `models/` matches at ANY depth and silently ignored triton/models/, which is why the
# Triton model repo went missing from git for weeks. Do not remove the slash.
/models/

# Build artifacts — ONNX/engine live in S3, never committed
engine/artifacts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
